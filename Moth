#clear the environment
rm(list = ls())

#load the libraries 
library(here)
library(tidyverse)
library(janitor)
library(sf)
library(rnaturalearth)
library(rnaturalearthdata)
library(patchwork)
library(sp)
library(adehabitatHR)

#download the data 
moth <- read.csv("~/Desktop/R Projects/Applied_Pop_Project/Data/Semirelect_Underwing.csv")

#clean the data 
obs_moth_clean <- moth |>
  dplyr::select(latitude, longitude) |> 
  drop_na()

#convert to simple features
moth_sf <- st_as_sf(obs_moth_clean,
                    coords = c("longitude", "latitude"),
                    crs = 4326)

#convert to equal area CRS
moth_proj <- st_transform(moth_sf, 5070)
moth_sp_points <- SpatialPoints(
  coords = st_coordinates(moth_proj),
  proj4string = CRS(st_crs(moth_proj)$proj4string))

#claculate MCP
moth_mcp_95 <- mcp(moth_sp_points,
  percent = 95)

#convert back to sf for plotting
moth_mcp_sf <- st_as_sf(moth_mcp_95) |>
  st_transform(4326)

#get state boundaries 
north_am <- ne_countries(country = c("United States of America", "Canada"), 
                         scale = "medium", 
                         returnclass = "sf")


#plot the data 
p_moth_mcp <- ggplot() +
  geom_sf(data = north_am, fill = "white", color = "gray10", size = .3) +
  geom_sf(data = moth_sf, color = "purple", alpha = 0.6, size = .5) +
  geom_sf(data = moth_mcp_sf, color = "purple", size = .5) +
  labs(
    title = "Semirelict Underwing MCP",
    subtitle = "Research observations") +
  theme_void(base_size = 14)

p_moth_mcp
